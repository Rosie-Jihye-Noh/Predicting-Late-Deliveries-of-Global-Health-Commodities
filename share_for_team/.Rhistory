y <- case0101$Score
g <- case0101$Treatment
diff_mean <- function(g) {
mean(y[g == "Intrinsic"]) - mean(y[g == "Extrinsic"])
}
obs <- diff_mean(g)
sim <- replicate(B, diff_mean(sample(g)))
p_mc <- (1 + sum(abs(sim) >= abs(obs))) / (B + 1)
