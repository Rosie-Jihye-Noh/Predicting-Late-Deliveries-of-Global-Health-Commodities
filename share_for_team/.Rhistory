library(Sleuth3)
str(ex0323)
yr   <- ex0323[[1]]   # year
rate <- ex0323[[2]]   # skin cancer rate
code <- ex0323[[3]]   # sunspot code
unique(code)
codes <- sort(unique(code))
high  <- ex0323[code == codes[1], ]
low   <- ex0323[code == codes[2], ]
nrow(high); nrow(low)
par(mfrow = c(1, 2))
plot(high[[1]], high[[2]],
xlab = "Year", ylab = "Skin cancer rate (per 100,000)",
main = "High sunspot activity", pch = 19)
plot(low[[1]], low[[2]],
xlab = "Year", ylab = "Skin cancer rate (per 100,000)",
main = "Low sunspot activity", pch = 19)
library(Sleuth3)
str(ex0323)   # check the real column names
# pick the columns by position (Year, Rate, Code)
yr   <- ex0323[[1]]
rate <- ex0323[[2]]
code <- ex0323[[3]]
unique(code)   # see what values the code has
# split into the two groups
codes <- sort(unique(code))
high  <- ex0323[code == codes[1], ]   # first code value
low   <- ex0323[code == codes[2], ]   # second code value
nrow(high); nrow(low)   # both should be above 0
par(mfrow = c(1, 2))
# plot 1: high sunspot group with a line
plot(high[[1]], high[[2]],
xlab = "Year", ylab = "Skin cancer rate (per 100,000)",
main = "High sunspot activity", pch = 19)
abline(lm(high[[2]] ~ high[[1]]), col = "red", lwd = 2)
# plot 2: low sunspot group with a line
plot(low[[1]], low[[2]],
xlab = "Year", ylab = "Skin cancer rate (per 100,000)",
main = "Low sunspot activity", pch = 19)
abline(lm(low[[2]] ~ low[[1]]), col = "red", lwd = 2)
