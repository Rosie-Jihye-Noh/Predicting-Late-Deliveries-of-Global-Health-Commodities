library(Sleuth3)
y2 <- ex0112$BP[ex0112$Diet == "RegularOil"]
n  <- length(y2)
m  <- mean(y2)
s  <- sd(y2)
df <- n - 1
c(mean = m, sd = s, df = df)
se <- s / sqrt(n)
se
ci <- m + c(-1, 1) * qt(0.975, df) * se
ci
#4c
ci <- m + c(-1, 1) * qt(0.975, df) * se
ci
#4d
t_stat <- m / se
p_val  <- 2 * pt(-abs(t_stat), df)
c(t = t_stat, p = p_val)
#4b standard error
se <- s / sqrt(n)
se
