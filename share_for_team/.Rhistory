library(Sleuth3)
library(mosaic)
str(ex0330)
ex0330$Educ <- factor(ex0330$Educ)
favstats(Income2005 ~ Educ, data = ex0330)
bwplot(Income2005 ~ Educ, data = ex0330)
densityplot(~ Income2005, groups = Educ, auto.key = TRUE, data = ex0330)
ex0330 <- transform(ex0330, logincome = log(Income2005))
favstats(logincome ~ Educ, data = ex0330)
bwplot(logincome ~ Educ, data = ex0330)
densityplot(~ logincome, groups = Educ, auto.key = TRUE, data = ex0330)
ttestlog <- t.test(logincome ~ Educ, data = ex0330)
ttestlog
est <- -(ttestlog$estimate[1] - ttestlog$estimate[2])
ci  <- -rev(ttestlog$conf.int)
exp(est)
exp(ci)
(exp(est) - 1) * 100
