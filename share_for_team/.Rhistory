A <- c(68, 77, 82, 85)
B <- c(53, 64, 71)
scores <- c(A, B)
obs_diff <- mean(A) - mean(B)          # 15.33
# all ways to pick which 4 students get guide A
splits <- combn(7, 4)                  # 4 x 35 matrix, one column per split
diffs <- apply(splits, 2, function(idx) {
mean(scores[idx]) - mean(scores[-idx])
})
length(diffs)                          # 35
sort(diffs)                            # all 35 differences
# two-sided p-value
p_value <- mean(abs(diffs) >= abs(obs_diff) - 1e-10)
p_value                                # 3/35 = 0.0857
clear
